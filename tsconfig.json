{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": false, "noImplicitAny": false, "strictNullChecks": false, "noEmit": true, "skipLibCheck": true, "isolatedModules": true
  },
  "include": ["src/**/*.ts"]
}
